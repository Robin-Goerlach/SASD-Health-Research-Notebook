<Window x:Class="Sasd.HealthNotebook.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SASD Health Research Notebook"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource SasdLightBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SasdNavyBrush}">
            <DockPanel LastChildFill="True" Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SASD"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="Health Research Notebook"
                               Foreground="#CDE8E5"
                               TextWrapping="Wrap"
                               Margin="0,4,0,24" />

                    <TextBlock Text="Navigation"
                               Foreground="#90CDF4"
                               FontWeight="Bold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Dashboard"
                               Foreground="White"
                               Margin="0,6,0,6" />
                    <TextBlock Text="Health topics"
                               Foreground="White"
                               Margin="0,6,0,6" />
                    <TextBlock Text="Documents (later)"
                               Foreground="#9FB3C8"
                               Margin="0,6,0,6" />
                    <TextBlock Text="Measurements (later)"
                               Foreground="#9FB3C8"
                               Margin="0,6,0,6" />
                    <TextBlock Text="Doctor questions (later)"
                               Foreground="#9FB3C8"
                               Margin="0,6,0,6" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Local-first · no cloud · no telemetry"
                           Foreground="#BCCCDC"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,18">
                <Button DockPanel.Dock="Right"
                        Content="New health topic"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="NewHealthTopicButton_Click" />
                <StackPanel>
                    <TextBlock Text="Dashboard"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#102A43" />
                    <TextBlock Text="Personal documentation for preparation, research and doctor conversations. No diagnosis or therapy recommendations."
                               Foreground="#52616B"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding DashboardCards}" Margin="0,0,0,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SasdCardBackgroundBrush}"
                                BorderBrush="#D9E2EC"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="#52616B"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Value}"
                                           Foreground="#102A43"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Margin="0,8,0,4" />
                                <TextBlock Text="{Binding Description}"
                                           Foreground="#627D98"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2"
                    Background="{StaticResource SasdCardBackgroundBrush}"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="Refresh"
                                Click="RefreshButton_Click" />
                        <TextBlock Text="Health topics"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#102A43" />
                    </DockPanel>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Topics}"
                              SelectedItem="{Binding SelectedTopic}"
                              BorderBrush="#D9E2EC"
                              BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Title" Width="260" DisplayMemberBinding="{Binding Title}" />
                                <GridViewColumn Header="Status" Width="140" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Priority" Width="180" DisplayMemberBinding="{Binding Priority}" />
                                <GridViewColumn Header="Created" Width="140" DisplayMemberBinding="{Binding CreatedAtText}" />
                                <GridViewColumn Header="Short description" Width="360" DisplayMemberBinding="{Binding ShortDescription}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Background="#E5EAF0" Padding="12,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#52616B"
                       Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
