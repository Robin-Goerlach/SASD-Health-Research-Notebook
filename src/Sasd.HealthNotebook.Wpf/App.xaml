<Application x:Class="Sasd.HealthNotebook.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="SasdNavyBrush" Color="#102A43" />
        <SolidColorBrush x:Key="SasdPetrolBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="SasdLightBackgroundBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="SasdCardBackgroundBrush" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SasdPetrolBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource SasdPetrolBrush}" />
        </Style>
    </Application.Resources>
</Application>
